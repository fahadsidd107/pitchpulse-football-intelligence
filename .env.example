# Local development configuration; API reads this file from the repository root.
# Copy to .env and replace placeholders. Never commit real credentials.
DATA_PROVIDER=mock
DEMO_MODE=true
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://pitchpulse:CHANGE_ME@localhost:5433/pitchpulse
POSTGRES_USER=pitchpulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pitchpulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://pitchpulse:CHANGE_ME@localhost:5672/%2f
RABBITMQ_DEFAULT_USER=pitchpulse
RABBITMQ_DEFAULT_PASS=CHANGE_ME
FOOTBALL_PROVIDER_BASE_URL=
FOOTBALL_PROVIDER_TOKEN=
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
RUST_LOG=info

# PostgreSQL uses 5433 to avoid colliding with a native local server.
POSTGRES_PORT=5433
REQUEST_TIMEOUT_SECONDS=5
